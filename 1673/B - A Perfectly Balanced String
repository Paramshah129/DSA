#include <bits/stdc++.h>
using namespace std;
 
typedef long long ll;
 
#define PB push_back
#define F first
#define S second
 
#define ALL(x) (x).begin(), (x).end()
#define RALL(x) (x).rbegin(), (x).rend()
 
#define DEBUG(x) cerr<<#x<<":"<<x<<"
";
 
void solve()
{
    string s;
    cin>>s;
    
    ll n=s.size();
    
    set<char> a;
    ll i;
    for (i=0;i<n;i++){
        if (a.find(s[i])==a.end()) a.insert(s[i]);
        else break;
    }
    
    for (ll j=i;j<n;j++){
        if (s[j]!=s[j-i]){
            cout<<"No
";
            return;
        }
    }
    cout<<"Yes
";
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin>>t;
    while(t--)
    {
	    solve();
    }
}