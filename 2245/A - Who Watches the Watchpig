#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
 
int main() {
	ll t;
	cin>>t;
	while(t--){
	    ll n,k;
	    cin>>n>>k;
	    string s;
	    cin>>s;
	    
	    if (k>n/2) cout<<"-1
";
	    else{
	        ll count=0;
	        for (ll i=0;i<k;i++){
	            if (s[i]=='L') count++;
	        }
	        for (ll i=n-1;i>=n-k;i--){
	            if (s[i]=='R') count++;
	        }
	        cout<<count<<"
";
	    }
	}
return 0;
}